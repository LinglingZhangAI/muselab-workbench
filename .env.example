# Optional server-side configuration. Copy to .env.local and restart Vite.
# Never use a VITE_ prefix for API keys.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Render server only. Paste these into Render environment settings, never VITE_.
MUSELAB_STORAGE=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=muselab-media
MUSELAB_PASSWORD=
# Render generates these for new Blueprint deployments.
MUSELAB_SESSION_SECRET=
MUSELAB_SYNC_TOKEN=

# Local migration/sync: copy to .env.cloud.local (ignored by Git).
MUSELAB_CLOUD_URL=
